# Discord Bot Token (from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Target Discord Channel ID (e.g. #activity channel in CS server)
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Optional: Guild ID for instant slash command registration
DISCORD_GUILD_ID=1433097119434276925

# Polling interval in seconds for 24/7 Gateway mode (default: 120)
POLL_INTERVAL_SECONDS=120

# Path to JSON state file for deduplicating notified activities
STATE_FILE=data/state.json
